# Copy to .env and fill in. Never commit the real .env.

PORT=5000
# 0.0.0.0 makes the API reachable from other devices on the same Wi-Fi.
HOST=0.0.0.0

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Optional. When set, the API caches through Redis instead of in-process
# memory. Leaving it blank is fine locally - the app falls back automatically.
# REDIS_URL=redis://localhost:6379

# Comma-separated allow-list. Leave blank in development to accept any origin
# (needed so phones on the LAN can reach the API).
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Delivery pricing (must match the values shown in the frontend cart).
FREE_SHIPPING_THRESHOLD=499
SHIPPING_FEE=49

# File uploads (Vercel Blob).
BLOB_READ_WRITE_TOKEN=

# Contact form email (Gmail app password, not the account password).
EMAIL_USER=
EMAIL_PASS=
